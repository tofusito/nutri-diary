# Copy to .env and fill in. Never commit the result: .env is git-ignored.
# Generate each secret with: openssl rand -base64 32

# ── Local development ────────────────────────────────────────────────────────
# Only used by `npm run server`; the compose stack builds its own URI below.
MONGODB_URI=mongodb://127.0.0.1:27017
HOST=127.0.0.1
PORT=3100
# Set to 1 to run without a password on loopback. Never on a reachable service.
DEV_AUTH_BYPASS=0

# ── The app ──────────────────────────────────────────────────────────────────
TZ=Europe/Madrid
# The real public origin. Same-origin checks on writes and the Secure session
# cookie both depend on it, and the camera needs HTTPS.
APP_ORIGIN=https://nutri.example.org
# Shared household password. Required unless AUTH_MODE=cloudflare.
APP_PASSWORD=
# Signs session cookies. Random per deployment; changing it logs everyone out.
SESSION_SECRET=

# ── Authentication ───────────────────────────────────────────────────────────
# "password" (default) or "cloudflare" to delegate sign-in to Cloudflare Access.
AUTH_MODE=password
# With AUTH_MODE=cloudflare, both of these make the origin verify the Access
# assertion instead of trusting whatever reaches it. The audience tag is the
# `kid` parameter of the Access login redirect for your hostname.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_ROOT_USERNAME=nutri_diary_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=nutri_diary_app
MONGO_APP_PASSWORD=
# Where the compose stack keeps state on the host.
MONGO_DATA_PATH=./data/mongo
BACKUP_PATH=./data/backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ── Optional ─────────────────────────────────────────────────────────────────
# Identifies this deployment to Open Food Facts. Point it at your own site.
OFF_USER_AGENT=NutriDiary/0.1 (https://nutri.example.org)
# Immutable tag to deploy instead of rebuilding. Leave empty to build locally.
NUTRI_DIARY_IMAGE=
# The tunnel is part of the stack: `docker compose up -d` brings it up too, and
# refuses to start without this.
TUNNEL_TOKEN=
