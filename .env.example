# Copy to .env locally; never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017
HOST=127.0.0.1
PORT=3100
# Required in production. Shared password for the household diary.
APP_PASSWORD=
# Public HTTPS origin served by the Cloudflare Tunnel. The camera scanner only
# works over HTTPS (or localhost), so this must be the https hostname.
APP_ORIGIN=https://nutri.tofusito.org
# Development only, never set on a publicly accessible service:
DEV_AUTH_BYPASS=0
# Optional source for generic foods:
USDA_API_KEY=
# Set a contact address when enabling Open Food Facts:
OFF_USER_AGENT=NutriDiary/0.1 (personal nutrition diary)
# Only needed when running cloudflared inside compose (profile "tunnel"):
TUNNEL_TOKEN=
